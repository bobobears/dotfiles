# 不备份私钥
ssh/id_*
!ssh/id_*.pub
!ssh/config

# 不备份日志/缓存/会话数据
hermes/logs/
hermes/*.bak.*
hermes/skills-output.txt

# 不备份 GNOME 完整 dump（太大），只保留子配置
gnome/dconf-full-backup.txt

# Skills 中忽略 git 仓库和缓存
hermes/skills/*/.git/
hermes/skills/*/node_modules/

# Skills 运行时状态/锁/用量统计（非配置，不备份）
hermes/skills/.bundled_manifest
hermes/skills/.curator_backups/
hermes/skills/.curator_ledger.jsonl
hermes/skills/.curator_state
hermes/skills/.hub/
hermes/skills/.locks/
hermes/skills/.usage.json
hermes/skills/.usage.json.lock
hermes/skills/*.tmp
hermes/skills/**/*.log

# 不备份含密钥的环境文件（保留 .env.example 模板）
.env
.env.local
hermes/skills/*/.env
hermes/skills/*/.env.local
